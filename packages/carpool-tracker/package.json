{
  "name": "@carpool/tracker",
  "version": "0.1.0",
  "description": "Retrieval for Carpool v2: rank prior research artifacts against a client-embedded question. The one genuinely new component — everything else in this product is plumbing.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bench": "tsx bench/run.ts"
  },
  "dependencies": {
    "@carpool/core": "workspace:*",
    "@huggingface/transformers": "^4.2.0",
    "better-sqlite3": "^11.8.1",
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
