# --- Hedera / x402 ---
HEDERA_NETWORK=hedera:testnet
FACILITATOR_URL=https://api.testnet.blocky402.com
USDC_TOKEN_ID=0.0.429274
MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# The registry's own settlement account. x402 payTo for every sale (never the
# author's — see apps/registry/README.md "Money" for why), and the account the
# settler (Task E) debits when it pays authors and itself out.
CARPOOL_ACCOUNT_ID=0.0.000000
CARPOOL_PRIVATE_KEY=

# Operator: creates + funds the carpool account and fleet accounts, pays
# association/creation fees.
OPERATOR_ACCOUNT_ID=0.0.000000
OPERATOR_PRIVATE_KEY=

# HCS topic for the settlement audit anchor (created by
# apps/registry/src/scripts/create-topic.ts; wired to anchorEpoch in Task E)
HCS_TOPIC_ID=0.0.000000

# Seconds between epoch-timer settle runs (Task E).
EPOCH_SECONDS=600

# --- Services ---
LEDGER_DB=./data/ledger.sqlite
ARTIFACT_STORE=./data/artifacts
REGISTRY_PORT=8403
# Registry JSON API base, read by the dashboard
NEXT_PUBLIC_SETTLEMENT_URL=http://localhost:8403
# Optional. A WalletConnect (Reown) project id from dashboard.reown.com. Enables
# "Connect wallet" for HashPack, Kabila and Blade on the earnings desk, read-only.
# Unset: that option is hidden and the desk says it is not configured.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# The registry-wide embedding tuple, served from GET /.well-known/carpool.
# EVERY client must embed with this exact pair: vectors from different models
# are not comparable, and the sqlite-vec index is fixed-dimension, so changing
# either of these against an existing database is a re-index migration, not a
# config tweak (TrackerIndex refuses to open on a mismatch, naming both tuples).
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Minimum cosine similarity for a GET /search hit to be considered at all.
# Biased toward precision per the brief: a miss costs the buyer a free redo, a
# false positive costs them money and trust. 0.55 is what
# `pnpm --filter @carpool/tracker bench` selects — on a SYNTHETIC corpus (see
# that package's README), so treat it as a tunable default, not a measurement.
SEARCH_SIMILARITY_THRESHOLD=0.55

# Flat µUSDC fee the tracker keeps per sale (never refunded). Matches v1's
# carpool fee. A publish is rejected if its priceFloor is below this — but that
# is the early warning, not the guard: raising this AFTER artifacts are live
# would otherwise make every subsequent sale of them accrue the fee in full
# against a royalty clamped to zero. `splitSale` in apps/registry/src/ledger.ts
# clamps the fee to what the sale received, so the payout rows sum to exactly
# `paid` whatever this is set to.
TRACKER_FEE_MICRO_USDC=500

# Shared secret gating POST /settle only — /publish and /refund authenticate
# themselves cryptographically (author_sig / buyer signature) instead, since
# both are actions by parties who cannot hold this secret. Required in
# production: without it anyone who can reach the registry can trigger a
# settlement run. Generate with: openssl rand -hex 32
LEDGER_API_KEY=
# Comma-separated origins allowed to read /search, /state, /events. Unset = any.
DASHBOARD_ORIGIN=

# ---------------------------------------------------------------- apps/mcp
# Buyer's per-payment spend cap, µUSDC. Derived, not picked: carpool_publish
# prices at 15% of what the research cost to produce (PRICE_SHARE_OF_REDO_COST),
# so this default is 10% x $5 = $0.50 — it buys anything that cost up to $5 to
# produce. Raise it together with that share, never alone; they are one decision
# in packages/carpool-core/src/pricing.ts and the tests assert the relationship.
# The x402 spend control rejects client-side before a request is sent, so a cap
# below the price rule's output is not a warning, it is a buyer that can never buy.
#
# This file said 15% and 750000 until AUDIT-CLAIMS.md M4 was resolved to a 0.10
# share. The constant is DERIVED in pricing.ts, so the code was never wrong; this
# comment was, which is the drift that resolution existed to stop.
CARPOOL_MAX_MICRO_USDC=500000

# Publishing consent for the PreToolUse hook: ask (default) or off. Nothing else
# — an unrecognised value is refused rather than treated as the default, and
# there is no value that publishes without asking first.
CARPOOL_PUBLISH_MODE=ask
